#!/bin/sh
# Called by udhcpc when a lease arrives. Sets the address, gateway and DNS,
# like a PC's network settings changing after "obtain an IP address automatically".
case "$1" in
  deconfig)
    ip -4 addr flush dev "$interface"
    ;;
  bound|renew)
    ip -4 addr flush dev "$interface"
    ip addr add "$ip/${mask:-24}" dev "$interface"
    if [ -n "$router" ]; then
      ip route replace default via "${router%% *}" dev "$interface"
    fi
    if [ -n "$dns" ]; then
      : > /etc/resolv.conf
      for s in $dns; do echo "nameserver $s" >> /etc/resolv.conf; done
      [ -n "$domain" ] && echo "search $domain" >> /etc/resolv.conf
    fi
    echo "DHCP lease: $ip/${mask:-24}  gateway ${router:-none}  dns ${dns:-none}  (from server ${serverid:-?})"
    ;;
esac
exit 0
