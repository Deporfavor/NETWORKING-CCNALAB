      "type": "router",
      "config": "hostname R1\n!\ninterface e0\n description CAMPUS-LAN (inside)\n ip address 192.168.1.1/24\n!\ninterface e1\n description TO-ISP (outside)\n ip address 198.51.100.2/30\n!\n"
    },
    "ISP": {
      "type": "router",
      "config": "hostname ISP\n!\ninterface e0\n description TO-CUSTOMER\n ip address 198.51.100.1/30\n!\ninterface e1\n description INTERNET\n ip address 203.0.113.1/24\n!\n"
    },
    "PC1": {
      "type": "host"
    },
    "PC2": {
      "type": "host"
    },
    "SRV": {
      "type": "host",
      "ip": "203.0.113.10/24",
      "gw": "203.0.113.1",
      "www": "<h1>web.isp.example</h1><p>You reached the Internet through NAT. Well done!</p>"
    }
  },
  "links": [
