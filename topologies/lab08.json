  "nodes": {
    "SW1": {
      "type": "switch",
      "config": [
        "configure terminal",
        "hostname SW1",
        "end"
      ]
    },
    "R1": {
      "type": "router",
      "config": "hostname R1\n!\nip route 0.0.0.0/0 198.51.100.1\n!\ninterface e0\n description OSPF-BACKBONE-LAN\n ip address 10.0.0.1/24\n!\ninterface e1\n description LAN-1\n ip address 192.168.1.1/24\n!\ninterface e2\n description TO-ISP\n ip address 198.51.100.2/30\n!\n"
    },
    "R2": {
      "type": "router",
      "config": "hostname R2\n!\ninterface e0\n description OSPF-BACKBONE-LAN\n ip address 10.0.0.2/24\n!\ninterface e1\n description LAN-2\n ip address 192.168.2.1/24\n!\n"
    },
    "R3": {
      "type": "router",
      "config": "hostname R3\n!\ninterface e0\n description OSPF-BACKBONE-LAN\n ip address 10.0.0.3/24\n!\ninterface e1\n description LAN-3\n ip address 192.168.3.1/24\n!\n"
    },
    "ISP": {
      "type": "router",
      "config": "hostname ISP\n!\nip route 10.0.0.0/24 198.51.100.2\nip route 192.168.0.0/16 198.51.100.2\n!\ninterface e0\n description TO-CUSTOMER\n ip address 198.51.100.1/30\n!\ninterface e1\n description INTERNET\n ip address 203.0.113.1/24\n!\n"
    },
    "PC1": {
      "type": "host",
      "ip": "192.168.1.11/24",
      "gw": "192.168.1.1"
    },
    "PC2": {
      "type": "host",
      "ip": "192.168.2.12/24",
      "gw": "192.168.2.1"
    },
    "PC3": {
      "type": "host",
      "ip": "192.168.3.13/24",
      "gw": "192.168.3.1"
    },
    "SRV": {
      "type": "host",
      "ip": "203.0.113.10/24",
      "gw": "203.0.113.1",
      "www": "<h1>Internet server</h1><p>OSPF delivered your default route.</p>"
    }
  },
